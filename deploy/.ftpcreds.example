# Cornerbites cPanel FTP credentials for deploy/upload.sh
# Copy this file to .ftpcreds and fill in real values. NEVER commit .ftpcreds.
#
#   cp deploy/.ftpcreds.example deploy/.ftpcreds

# FTP server hostname (from cPanel > FTP Accounts, or the shared-IP hostname)
FTP_HOST="ftp.cornerbites.co.ke"

# FTP username (e.g. deployer@rayofhopewomen.org, or your cPanel user)
FTP_USER="deployer@rayofhopewomen.org"

# FTP password
FTP_PASS="CHANGE_ME"

# FTP port (21 = plain FTP, 22 = SFTP is NOT supported by this script)
FTP_PORT="21"

# Remote directory to drop the zips (cPanel home = ".")
REMOTE_DIR="."
