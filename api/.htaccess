Options +FollowSymlinks
Options -MultiViews
RewriteEngine on
RewriteBase /api/
# Allow direct access to specific endpoint scripts (no wpos.php routing)
RewriteCond %{REQUEST_URI} (webhooks|poll|process_inbox|process_whatsapp|setup_tables|import_items|assemble|receive_chunk|cleanup_tmp|save_whatsapp_config|save_website_content|website_content|get_whatsapp_config|menu)\.php
RewriteRule ^ - [L]
# Route everything else to wpos.php
RewriteCond %{REQUEST_URI} !wpos.php
RewriteRule ^(.*)$ wpos.php?a=$1 [L,NS,QSA]
