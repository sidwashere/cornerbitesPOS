AddType application/x-httpd-php .appcache
AddType image/webp .webp
<IfModule mod_expires.c>
  <Files *.appcache>
      ExpiresActive On
      ExpiresDefault "access plus 0 seconds"
  </Files>
  # Optimised carousel images are content-versioned by timestamp — cache hard
  <FilesMatch "\.(jpg|jpeg|png|webp)$">
      ExpiresActive On
      ExpiresDefault "access plus 1 month"
      Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# --- Route public webhook endpoints to the API ---
# The website (and future platforms) POST to /webhooks/<platform>;
# forward those to api/webhooks.php?platform=<platform>.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    # Route public webhook endpoints to the API
    RewriteRule ^webhooks/([^/]+)/?$ api/webhooks.php?platform=$1 [L,QSA]
    # Block internal directories (migration scripts, vendor libs) from HTTP
    RewriteRule ^(setup|node_modules)/ - [F]
</IfModule>


# --- Session lifetime (12 hours) ---
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 43200
    php_value session.cookie_lifetime 43200
</IfModule>

# --- Image uploads (Website CMS) ---
# LiteSpeed reads php_value from .htaccess; raise the 2M default so real photos
# from the CMS uploader go through. The CMS also downsizes client-side as a belt
# and braces measure.
<IfModule LiteSpeed>
    php_value upload_max_filesize 20M
    php_value post_max_size 24M
    php_value memory_limit 256M
</IfModule>

# --- Cornerbites POS production hardening ---
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
<FilesMatch "(\.dbconfig\.json|\.config\.json|composer\.(json|lock)|package(-lock)?\.json|Procfile|\.buildpacks|apt-packages|nginx\.conf\.sigil)$">
    Order allow,deny
    Deny from all
</FilesMatch>
